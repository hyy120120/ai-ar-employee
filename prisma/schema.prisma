generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  ADMIN
  MEMBER
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

enum AIActionType {
  REMINDER
  RESEND_INVOICE
  PAYMENT_DATE_REQUEST
  MISSING_PO
  DISPUTE
  PAYMENT_PROMISE
  ESCALATE
}

enum AIActionStatus {
  PENDING
  APPROVED
  REJECTED
  SENT
  FAILED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  customers Customer[]
  invoices  Invoice[]
  actions   AIAction[]
  auditLogs AuditLog[]
  googleConnection GoogleConnection?
}

model User {
  id             String       @id @default(cuid())
  organizationId String
  email          String
  name           String?
  role           UserRole     @default(MEMBER)
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, email])
  @@index([organizationId])
}

model Customer {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  email          String?
  externalId     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoices       Invoice[]

  @@index([organizationId])
  @@index([organizationId, externalId])
}

model Invoice {
  id             String        @id @default(cuid())
  organizationId String
  customerId     String
  externalId     String?
  invoiceNumber  String
  amount         Decimal       @db.Decimal(12, 2)
  balanceDue     Decimal       @db.Decimal(12, 2)
  issueDate      DateTime
  dueDate        DateTime
  status         InvoiceStatus @default(OPEN)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer       Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  payments       Payment[]
  actions        AIAction[]
  evidence       InvoiceEvidence[]
 investigations InvoiceInvestigation[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([customerId])
  @@index([dueDate])
}

model Payment {
  id          String   @id @default(cuid())
  invoiceId   String
  externalId  String?
  amount      Decimal  @db.Decimal(12, 2)
  paidAt      DateTime
  createdAt   DateTime @default(now())

  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([paidAt])
}

model AIAction {
  id             String         @id @default(cuid())
  organizationId String
  invoiceId      String?
  type           AIActionType
  status         AIActionStatus @default(PENDING)
  executionStartedAt DateTime?
  riskLevel      RiskLevel
  reason         String?
  recommendation String?
  draftSubject   String?
  draftBody      String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice        Invoice?       @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([invoiceId])
  @@index([organizationId, status])
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  userId         String?
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
}
enum EvidenceType {
  INVOICE
  PAYMENT
  EMAIL
  NOTE
  SYSTEM
}

model InvoiceEvidence {
  id          String       @id @default(cuid())
  invoiceId   String
  type        EvidenceType
  title       String
  content     String
  sourceId    String?
  observedAt  DateTime
  createdAt   DateTime     @default(now())

  invoice     Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([invoiceId, observedAt])
}

model InvoiceInvestigation {
  id                String     @id @default(cuid())
  invoiceId         String
  finding           String
  confidence        Decimal    @db.Decimal(5, 4)
  recommendedAction String
  riskLevel         RiskLevel
  createdAt         DateTime   @default(now())

  invoice           Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([invoiceId, createdAt])
}

model GoogleConnection {
  id             String   @id @default(cuid())
  organizationId String   @unique
  email          String?
  accessToken    String?
  refreshToken   String
  tokenExpiresAt DateTime?
  scope          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}